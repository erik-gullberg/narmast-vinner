# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# CARTO Basemaps (https://carto.com/basemaps/apikey)
# Public usage identifier, not a secret — tiles are fetched client-side.
NEXT_PUBLIC_CARTO_KEY=your-carto-basemaps-key

# Admin / Event-Tinder (/admin) — server-only secrets, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_PASSWORD=choose-a-strong-admin-password

